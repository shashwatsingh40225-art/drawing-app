VITE_SUPABASE_URL=https://your-project.supabase.co
VITE_SUPABASE_ANON_KEY=your-anon-key-here

# Optional: only needed when the built app is loaded from an origin without /api
# alongside it (e.g. a packaged mobile app). Leave unset for the web app.
# VITE_API_BASE_URL=https://kin-app.vercel.app

# Server-only (read by api/recap.ts; never prefix with VITE_, which would ship it to browsers)
GEMINI_API_KEY=your-gemini-api-key-here
# Optional: comma-separated Gemini models to try in order (default: gemini-flash-latest,gemini-2.5-flash)
# GEMINI_MODEL=gemini-flash-latest,gemini-2.5-flash

# Optional fallback provider, tried only if Gemini is unconfigured, rate-limited, or unreachable
# (a separate quota pool from a different vendor). NVIDIA_NIM_API_KEY also works if that's what
# your NVIDIA integration provides.
NVIDIA_API_KEY=your-nvidia-nim-api-key-here
NVIDIA_BASE_URL=https://integrate.api.nvidia.com/v1
# Optional: comma-separated NVIDIA NIM models to try in order (default below)
# NVIDIA_MODEL=meta/llama-3.3-70b-instruct,meta/llama-3.1-8b-instruct,mistralai/mixtral-8x22b-instruct-v0.1
